<script>
function show(i){
  document.querySelectorAll('.slide').forEach((s,j)=>s.classList.toggle('on',j===i));
  document.querySelectorAll('.tol-nav-btn').forEach((b,j)=>b.classList.toggle('on',j===i));
}
function toggleLayer(i){
  const ld=document.getElementById('ld'+i),sl=document.getElementById('sl'+i);
  const isOpen=ld.classList.contains('open');
  document.querySelectorAll('.ld').forEach(d=>d.classList.remove('open'));
  document.querySelectorAll('.sl').forEach(s=>s.classList.remove('open'));
  if(!isOpen){ld.classList.add('open');sl.classList.add('open');}
}
function toggleEng(i){
  const ed=document.getElementById('ed'+i),eng=ed.closest('.eng');
  const isOpen=ed.classList.contains('open');
  document.querySelectorAll('.ed').forEach(d=>d.classList.remove('open'));
  document.querySelectorAll('.eng').forEach(e=>e.classList.remove('open'));
  if(!isOpen){ed.classList.add('open');eng.classList.add('open');}
}
</script>
