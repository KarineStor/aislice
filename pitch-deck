  transition:all .18s;white-space:nowrap;flex-shrink:0;
}
.tol-nav-btn:hover{color:rgba(255,255,255,0.75);}
.tol-nav-btn.on{color:var(--cyan-500);border-bottom-color:var(--cyan-500);}

.slide{display:none;padding:28px 24px 32px;animation:fi .25s ease;}
.slide.on{display:block;}
@keyframes fi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}

.eyebrow{font-size:12.7px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--cyan-500);margin-bottom:6px;}
.h1{font-size:32.3px;font-weight:800;color:#fff;letter-spacing:-.02em;line-height:1.15;margin-bottom:6px;}
.sub{font-size:16.2px;color:rgba(255,255,255,0.5);line-height:1.6;margin-bottom:22px;}
.sub em{color:var(--cyan-400);font-style:normal;}

.quote{
  border-left:2px solid var(--cyan-500);
  padding:12px 16px;margin:20px 0;
  font-size:15px;color:rgba(255,255,255,0.6);
  line-height:1.7;font-style:italic;
  background:rgba(0,200,255,0.04);
  border-radius:0 8px 8px 0;
}
.quote strong{color:var(--cyan-400);font-style:normal;}

.pill-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px;}
.pill{
  font-size:12.7px;font-weight:500;
  padding:4px 12px;border-radius:20px;
  background:rgba(0,200,255,0.12);
  color:var(--cyan-400);
  border:0.5px solid rgba(0,200,255,0.25);
}

.tx-grid{
  display:grid;grid-template-columns:1fr 36px 1fr;
  align-items:stretch;gap:0;margin-bottom:20px;
}
.tx-col{border-radius:10px;padding:14px 16px;border:0.5px solid rgba(255,255,255,0.08);}
.tx-col.old{background:rgba(255,255,255,0.04);}
.tx-col.new{background:rgba(0,200,255,0.07);border-color:rgba(0,200,255,0.2);}
.tx-col h4{font-size:11.5px;text-transform:uppercase;letter-spacing:.09em;font-weight:600;margin-bottom:10px;}
.tx-col.old h4{color:var(--ink-500);}
.tx-col.new h4{color:var(--cyan-500);}
.tx-col ul{list-style:none;}
.tx-col ul li{font-size:13.9px;padding:4px 0;border-bottom:0.5px solid rgba(255,255,255,0.06);color:rgba(255,255,255,0.45);}
.tx-col.new ul li{color:rgba(255,255,255,0.75);}
.tx-col ul li:last-child{border:none;}
.arr-mid{display:flex;align-items:center;justify-content:center;color:var(--cyan-500);font-size:18px;}

.stack{display:flex;flex-direction:column;gap:3px;margin-top:4px;}
.sl{
  display:flex;align-items:center;gap:10px;
  border:0.5px solid rgba(255,255,255,0.08);
  border-radius:8px;padding:11px 14px;cursor:pointer;transition:all .15s;
}
.sl:hover{background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.15);}
.sl.open{background:rgba(0,200,255,0.09);border-color:rgba(0,200,255,0.35);}
.sl-n{font-size:11.5px;font-weight:700;color:var(--ink-500);min-width:16px;}
.sl-n2{font-size:15px;font-weight:600;color:#fff;flex:1;}
.sl-r{font-size:12.7px;color:rgba(255,255,255,0.35);text-align:right;max-width:180px;}
.sl.open .sl-n2{color:var(--cyan-400);}
.sl.open .sl-r{color:var(--cyan-500);}

.ld{display:none;background:rgba(0,200,255,0.06);border:0.5px solid rgba(0,200,255,0.2);border-radius:8px;padding:13px 15px;margin:2px 0 4px;}
.ld.open{display:block;animation:fi .2s ease;}
.ld p{font-size:13.9px;color:rgba(255,255,255,0.55);line-height:1.7;}

.eco-center{
  border:1.5px solid var(--cyan-500);border-radius:12px;padding:14px 18px;
  background:rgba(0,200,255,0.07);text-align:center;margin-bottom:10px;
}
.eco-center h3{font-size:16.2px;font-weight:700;color:var(--cyan-400);margin-bottom:10px;}
.eco-center ul{list-style:none;display:flex;flex-wrap:wrap;gap:6px;justify-content:center;}
.eco-center ul li{font-size:12.7px;padding:3px 10px;border-radius:20px;background:rgba(255,255,255,0.07);color:var(--cyan-400);border:0.5px solid rgba(0,200,255,0.25);}

.eco-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;}
.eco-card{border:0.5px solid rgba(255,255,255,0.08);border-radius:10px;padding:12px 14px;background:rgba(255,255,255,0.03);}
.eco-card h4{font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;font-weight:600;color:var(--ink-500);margin-bottom:8px;}
.eco-card ul{list-style:none;}
.eco-card ul li{font-size:12.7px;color:rgba(255,255,255,0.45);padding:2px 0;}

.engines{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:4px 0 16px;}
.eng{
  border:0.5px solid rgba(255,255,255,0.08);border-radius:10px;padding:14px;
  cursor:pointer;transition:all .18s;background:rgba(255,255,255,0.03);
}
.eng:hover{background:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.15);}
.eng.open{background:rgba(0,200,255,0.07);border-color:rgba(0,200,255,0.3);}
.eng-n{font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-500);margin-bottom:4px;}
.eng-t{font-size:16.2px;font-weight:700;color:#fff;margin-bottom:3px;}
.eng-m{font-size:12.7px;color:rgba(255,255,255,0.35);}
.ed{display:none;margin-top:10px;border-top:0.5px solid rgba(255,255,255,0.08);padding-top:10px;}
.ed.open{display:block;}
.ed li{font-size:12.7px;color:rgba(255,255,255,0.5);padding:2px 0;list-style:none;}
.ed li::before{content:'— ';color:var(--ink-500);}

.pkg-table{width:100%;border-collapse:collapse;}
.pkg-table th{font-size:11.5px;text-transform:uppercase;letter-spacing:.07em;font-weight:600;color:var(--ink-500);text-align:left;padding:8px 12px;border-bottom:0.5px solid rgba(255,255,255,0.08);}
.pkg-table td{padding:10px 12px;border-bottom:0.5px solid rgba(255,255,255,0.06);color:rgba(255,255,255,0.5);font-size:13.9px;}
.pkg-table td:first-child{font-weight:600;color:#fff;}
.pkg-table tr:last-child td{border:none;}

.timeline{display:flex;flex-direction:column;}
.phase{display:grid;grid-template-columns:110px 1fr;gap:14px;padding:16px 0;border-bottom:0.5px solid rgba(255,255,255,0.07);}
.phase:last-child{border:none;}
.ph-lbl{text-align:right;}
.ph-tag{display:inline-block;font-size:11.5px;font-weight:700;letter-spacing:.06em;padding:3px 10px;border-radius:20px;text-transform:uppercase;}
.ph-tag.p1{background:rgba(0,200,255,0.15);color:var(--cyan-400);border:0.5px solid rgba(0,200,255,0.3);}
.ph-tag.p2{background:rgba(255,255,255,0.07);color:rgba(255,255,255,0.5);border:0.5px solid rgba(255,255,255,0.1);}
.ph-tag.p3{background:rgba(255,200,61,0.1);color:var(--sun);border:0.5px solid rgba(255,200,61,0.2);}
.ph-time{font-size:11.5px;color:var(--ink-500);margin-top:5px;}
.ph-name{font-size:16.2px;font-weight:700;color:#fff;margin-bottom:4px;}
.ph-focus{font-size:13.9px;color:rgba(255,255,255,0.45);line-height:1.6;margin-bottom:8px;}
.kpi-row{display:flex;gap:6px;flex-wrap:wrap;}
.kpi{font-size:11.5px;padding:2px 8px;border-radius:4px;background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.4);}

.impact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:6px;margin-top:16px;}
.ic{border:0.5px solid rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;}
.ic .area{font-size:11.5px;color:var(--ink-500);margin-bottom:4px;}
.ic .val{font-size:13.9px;font-weight:600;color:var(--cyan-400);}

/* ── Mobile ──────────────────────────────────────────────────── */
@media(max-width:540px){
  .tol{font-size:108%;border-radius:12px;}

  .tol-nav{padding:0 12px;}
  .wordmark{font-size:15px;margin-right:10px;}
  .tol-nav-btn{font-size:12px;padding:12px 10px;}

  .slide{padding:20px 16px 28px;}

  .eyebrow{font-size:11px;}
  .h1{font-size:24px;}
  .sub{font-size:14px;margin-bottom:16px;}
  .quote{font-size:13px;padding:10px 13px;}
  .pill{font-size:11px;padding:3px 10px;}

  .tx-grid{grid-template-columns:1fr;gap:8px;}
  .arr-mid{transform:rotate(90deg);font-size:22px;padding:4px 0;}

  .sl-r{display:none;}
  .sl-n2{font-size:13px;}
  .ld p{font-size:13px;}

  .eco-center h3{font-size:14px;}
  .eco-center ul li{font-size:11px;}
  .eco-grid{grid-template-columns:1fr 1fr;}
  .eco-card h4{font-size:10px;}
  .eco-card ul li{font-size:12px;}

  .engines{grid-template-columns:1fr;}
  .eng-t{font-size:15px;}
  .eng-m{font-size:12px;}
  .ed li{font-size:12px;}

  .pkg-table th{font-size:10px;padding:7px 10px;}
  .pkg-table td{font-size:12.5px;padding:8px 10px;}

  .phase{grid-template-columns:1fr;gap:6px;}
  .ph-lbl{text-align:left;display:flex;align-items:center;gap:10px;}
  .ph-time{margin-top:0;}
  .ph-name{font-size:15px;}
  .ph-focus{font-size:13px;}
  .kpi{font-size:10.5px;}

  .impact-grid{grid-template-columns:1fr 1fr;}
  .ic .area{font-size:10.5px;}
  .ic .val{font-size:13px;}
}
</style>

