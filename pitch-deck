
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&display=swap');

*{box-sizing:border-box;margin:0;padding:0;}

:root{
  --navy-900:#070452;
  --navy-800:#0C0968;
  --cyan-500:#00C8FF;
  --cyan-400:#3FD6FF;
  --coral:#FF4A6E;
  --sun:#FFC83D;
